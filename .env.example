# OpenAI research engine. The model (gpt-5.5-2026-04-23), medium reasoning, tool-call caps, background mode, hosted web search and
# the lead_research_v1 schema are pinned in src/lib/research/contract.ts. Change them only after rerunning the
# evaluation. Without a key, development mode uses clearly labelled sample data.
OPENAI_API_KEY=

# Exa search for the discovery pipeline (semantic search with publication-date filters and page text).
# With EXA_API_KEY and OPENAI_API_KEY set, research runs through the pipeline: the application searches (Exa,
# Reddit, Hacker News), triages, reads pages, and the research model qualifies from full text without tools.
EXA_API_KEY=

# Reddit: its API is limited to approved partners since May 2026, servers get 403, and Exa does not index Reddit at
# all. Reddit posts are found and read through OpenAI's hosted browsing (a Reddit-focused pass per topic). Only set
# these if you hold Reddit partner access.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# Force a provider: "pipeline", "openai" (single hosted-search request) or "mock". Defaults to pipeline when
# EXA_API_KEY is set, openai when only OPENAI_API_KEY is set, mock in development otherwise.
RESEARCH_PROVIDER=

# "structured" (default): schema on the research request.
# "two_step": documented fallback if model + background + search + schema is rejected: research first, then a
# tool-free formatting request with the same schema. Measure its cost before switching.
RESEARCH_OUTPUT_MODE=structured

# Postgres connection string (postgresql://…). For Supabase: Project Settings → Database → Connection string.
# Without it, an embedded Postgres (PGlite) is stored in ./.data
DATABASE_URL=

# Protects /api/cron/tick. Call it every minute with: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Email delivery (Resend). EMAIL_FROM must use a domain verified in Resend, e.g. "Lead Radar <leads@yourdomain.com>".
# Without these in development, emails are written to .data/emails/*.html instead of being sent.
RESEND_API_KEY=
# A bare address gets "Not Another Agent" added as the sender name.
EMAIL_FROM=
# Optional: where replies go. Defaults to the EMAIL_FROM address.
EMAIL_REPLY_TO=
# At least 32 random characters. Encrypts the private link stored for emails and signs unsubscribe links.
# Changing it breaks links in already-queued emails and existing unsubscribe links.
APP_SECRET=
# Public base URL used in email links. Defaults to Vercel's production URL.
APP_URL=

# Paid activation (Stripe). Create a recurring $99/month price and a webhook endpoint for
# POST /api/stripe/webhook with the events checkout.session.completed, invoice.paid, invoice.payment_failed,
# customer.subscription.updated and customer.subscription.deleted. Without these the desk shows no activation button.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Price shown in the app (display only; the charged amount is the Stripe price).
PLAN_PRICE_USD=99

# Active agents: one complete run per day at 8:00 local, which also polls the communities where earlier runs found
# candidates. WATCH_INTERVAL_HOURS > 0 adds extra polls between morning runs (off by default; they pause at the monthly
# cap per radar and email at once only for an explicit request scoring at least INSTANT_ALERT_MIN_SCORE of 10).
WATCH_INTERVAL_HOURS=0
MONTHLY_RADAR_BUDGET_USD=25
INSTANT_ALERT_MIN_SCORE=8

# Operating budgets (spec §1.7)
RUN_DEADLINE_MINUTES=10
RETRY_BACKOFF_SECONDS=60
DAILY_RUN_CAP=200
DAILY_SPEND_CAP_USD=50
SLOW_RUN_THRESHOLD_SECONDS=240
CREATE_RATE_LIMIT_PER_HOUR=5
RETRY_RATE_LIMIT_PER_HOUR=5
# Days a free radar has to complete (and retry) its first search. Paid radars are alive until the end of the paid period.
RESEARCH_PERIOD_DAYS=14

# Cost accounting (USD). Set from current pricing; used for cost per run and per lead and for the budget caps.
# Main model (qualification, brief) and small model (searches, triage, page reads, enrichment) are priced apart.
COST_INPUT_PER_MTOK=
COST_OUTPUT_PER_MTOK=
COST_SMALL_INPUT_PER_MTOK=
COST_SMALL_OUTPUT_PER_MTOK=
COST_PER_WEB_SEARCH=

# Development only: run the scheduler inside the dev server every N seconds (0 disables)
DEV_SCHEDULER_INTERVAL_SECONDS=5
